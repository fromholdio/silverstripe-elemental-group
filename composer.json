{
    "name": "fromholdio/silverstripe-elemental-group",
    "type": "silverstripe-vendormodule",
    "description": "Elemental block type 'Group' which holds other elemental blocks (akin to ElementList)",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "elemental",
        "group",
        "list"
    ],
    "homepage": "https://github.com/fromholdio/silverstripe-elemental-group",
    "support": {
        "issues": "https://github.com/fromholdio/silverstripe-elemental-group/issues"
    },
    "authors": [
        {
            "name": "Luke Fromhold",
            "homepage": "https://fromhold.io"
        }
    ],
    "require": {
        "silverstripe/vendor-plugin": "^3",
        "silverstripe/cms": "^6",
        "dnadesign/silverstripe-elemental": "^6",
        "fromholdio/silverstripe-elemental-multiarea": "^2"
    },
    "autoload": {
        "psr-4": {
            "Fromholdio\\ElementalGroup\\": "src/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
